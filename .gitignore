# =========================
# Python Artifacts
# =========================
__pycache__/
*.pyc
*.pyo
*.pyd
*.so
*.egg-info/
.pytest_cache/
.mypy_cache/
ruff_cache/

# =========================
# Virtual Environments
# =========================
.venv/
.venv311/
venv/
env/
ENV/

# =========================
# Model Checkpoints / Weights
# =========================
checkpoints/*
!checkpoints/*.json
!checkpoints/*.md
checkpoints_v2/*
!checkpoints_v2/*.json
checkpoints_old/*
!checkpoints_old/*.json
checkpoints_gpu/          # per-run dirs written by run_visual_experiment.py
*.pt
*.pth
*.ckpt
*.safetensors
yolo11m.pt

# The two frozen baseline checkpoints ARE tracked, deliberately. They are
# ~300 KB each, and GPU_EXPERIMENTS.md step 4 requires reproducing E0/E2
# before any new training - which is impossible on a fresh clone if the
# weights do not travel with the repo. These negations must sit AFTER the
# "*.pt" rule above or it re-excludes them.
!checkpoints/relation_mlp.pt
!checkpoints_e2_geo/relation_mlp.pt

# CLIP feature caches are regenerated by build_clip_cache.py (hundreds of MB).
clip_cache*.pt
*.pt.shards/

# =========================
# Datasets & Large Data
# =========================
data/
datasets/
visual_genome/
coco/
hallucinating images/
!data/.gitkeep

# =========================
# Generated Outputs
# =========================
outputs/
debug/

# Result JSONs are small and ARE tracked - they carry the frozen baselines and
# the provenance of every GPU run, which is the whole point of recording them.
# Logs and any large artefacts alongside them are not.
results/**
!results/**/
!results/**/*.json
results_gpu/**
!results_gpu/**/
!results_gpu/**/*.json

# Caption experiment (run_caption_experiment.py). Generated captions,
# per-pair relation records and example images stay local; only the small
# provenance/summary JSONs are trackable.
results_caption/**
!results_caption/**/
!results_caption/relation_checkpoint_selection.json
!results_caption/*/run_config.json
!results_caption/*/caption_results.json
!results_caption/*/caption_results.md
!results_caption/*/smoke_report.json
*.jsonl

visualizations/
eval_outputs/
analysis_results/
test_images/visual_diagnostics/
logs/
*.log
*.csv
*.png
*.jpg
*.jpeg

# =========================
# HuggingFace / Cache
# =========================
.cache/
.huggingface/
huggingface/
hf_cache/
torch_cache/
*.pkl
*.pickle

# =========================
# OS / Editor Files
# =========================
.DS_Store
Thumbs.db
.vscode/
.idea/

# =========================
# Temporary / Debug Files
# =========================
temp/
tmp/
*.tmp
gitignore_out.txt
__gitignore_content.txt

# =========================
# Jupyter / Build / Experiment Trackers
